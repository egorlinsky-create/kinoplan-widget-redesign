  "body": "{\n\t\"3DGlasses\": \"3D-очки\",\n\t\"AboutAdvertiser\": \"О рекламодателе\",\n\t\"Account\": \"Профиль\",\n\t\"Activate\": \"Активировать\",\n\t\"Actors\": \"Актёры\",\n\t\"ActualAddressIsUnknown\": \"Фактический адрес неизвестен\",\n\t\"Add\": \"Добавить\",\n\t\"Add3DGlassesToOrderOrBringYourOwn\": \"Добавьте в заказ 3D-очки или принесите свои.\",\n\t\"AddComboSetNowAndGetItWithoutQueue\": \"Добавьте комбонабор сейчас и получите его без очереди. Просто сообщите номер заказа в баре.\",\n\t\"AddForPrice\": \"Добавить за {{price}}\",\n\t\"AdditionalProducts\": \"Дополнительные товары\",\n\t\"AddToOrder\": \"Добавить в заказ\",\n\t\"Advertisement\": \"Реклама\",\n\t\"After\": \"Через:\",\n\t\"All\": \"Все\",\n\t\"AllSeatsAreOccupied\": \"Все места заняты\",\n\t\"AllTicketsAre\": \"Все билеты по\",\n\t\"AllTicketsSessionSoldOut\": \"Все билеты на этот сеанс проданы\",\n\t\"Alright\": \"Хорошо\",\n\t\"AndMoreProducts__few\": \"и еще {{count}} товара\",\n\t\"AndMoreProducts__many\": \"и еще {{count}} товаров\",\n\t\"AndMoreProducts__one\": \"и еще {{count}} товар\",\n\t\"AndMoreProducts__other\": \"и еще {{count}} товаров\",\n\t\"AnErrorWhenPayingWithPushkinCard\": \"Возникла ошибка при оплате Пушкинской картой.\",\n\t\"Apply\": \"Применить\",\n\t\"ApplyCard\": \"Применить карту\",\n\t\"ApplyCertificate\": \"Применить сертификат\",\n\t\"ApplyPIN\": \"Применить пин-код\",\n\t\"AreYouSure\": \"Вы уверены?\",\n\t\"AuthorizationFailedMessage\": \"Не удалось авторизоваться\",\n\t\"Available\": \"Доступно:\",\n\t\"account\": {\n\t\t\"AfterIssuingYouWillNotUnlinkIt\": \"После выпуска виртуальной карты вы не сможете отвязать её от аккаунта, чтобы привязать физический экземпляр.\",\n\t\t\"Approved\": \"Оплачен\",\n\t\t\"ApprovedOrder\": \"Заказ оплачен\",\n\t\t\"AwaitingPaymentConfirmation\": \"Ожидаем подтверждения оплаты от банка.\",\n\t\t\"AwaitingPaymentConfirmationDescription\": \"Если оплата не произойдет, бронь автоматически снимется в течение 15 минут с момента создания заказа, заказ будет отменен и места вернутся в продажу.\",\n\t\t\"accrued\": \"начислено\",\n\t\t\"Balance\": \"Баланс\",\n\t\t\"Bind\": \"Привязать\",\n\t\t\"BuyTickets\": \"Купить билеты\",\n\t\t\"Canceled\": \"Отменён\",\n\t\t\"CanceledOrder\": \"Заказ отменён\",\n\t\t\"DescribeForNewEmailAddress\": \"По ней будет проходить авторизация, а еще приходить билеты.\",\n\t\t\"Details\": \"Подробнее\",\n\t\t\"EnterNewEmailAddress\": \"Укажите новый адрес электронной почты\",\n\t\t\"FailedGetListOfBoughtTickets\": \"Не удалось получить список купленных билетов\",\n\t\t\"GuestOrdersAlert\": \"Билеты хранятся на этом устройстве, чтобы синхронизировать их с другими, войдите в профиль или зарегистрируйтесь.\",\n\t\t\"IssueVirtualCard\": \"Выпустить виртуальную карту\",\n\t\t\"LinkCard\": \"Привязать карту\",\n\t\t\"LoadMore\": \"Загрузить ещё\",\n\t\t\"MyOrders\": \"Мои заказы\",\n\t\t\"NoTransactionsOnVirtualBonusCard\": \"По виртуальной бонусной карте<br />пока не совершено операций.\",\n\t\t\"Order\": \"Заказ\",\n\t\t\"PageDescription\": {\n\t\t\t\"Bonuses\": \"Бонусы\",\n\t\t\t\"Notification\": \"Уведомления\",\n\t\t\t\"Orders\": \"Мои заказы\",\n\t\t\t\"Profile\": \"Профиль\"\n\t\t},\n\t\t\"Pin\": \"Пин-код\",\n\t\t\"Processing\": \"Не оплачен\",\n\t\t\"ProcessingOrder\": \"Заказ в процессе оплаты\",\n\t\t\"QRCode\": \"QR-код\",\n\t\t\"Refund\": \"Возврат\",\n\t\t\"RefundedOrder\": \"Заказ возвращен\",\n\t\t\"RefundIssued\": \"Оформить возврат\",\n\t\t\"RefundUnavailable\": \"Возврат недоступен для данной продажи\",\n\t\t\"ReturnOrder\": \"Вернуть заказ\",\n\t\t\"SaleInInappropriateStatus\": \"Продажа в неподходящем статусе\",\n\t\t\"SaleNotFound\": \"Продажа не обнаружена\",\n\t\t\"SaveChanges\": \"Сохранить изменения\",\n\t\t\"SeancePassed\": \"Сеанс завершен\",\n\t\t\"UnableRefundOrder\": \"Невозможно вернуть заказ: Элементы заказа уже были выданы.\",\n\t\t\"UnlinkCard\": \"Отвязать\",\n\t\t\"UseCinemaCard\": \"Используйте карту кинотеатра и начинайте экономить\",\n\t\t\"writeOff\": \"списание\",\n\t\t\"YouCurrentlyHaveNoOrders\": \"На данный момент у вас нет заказов\",\n\t\t\"YouDoNotHaveBonusCard\": \"У вас нет бонусной карты\"\n\t},\n\t\"appSideBarCurrentStep\": {\n\t\t\"accessory\": \"Добавьте 3D-очки\",\n\t\t\"bar\": \"Добавьте еду и напитки\",\n\t\t\"basket\": \"Проверьте ваш заказ\",\n\t\t\"contacts\": \"Введите данные для покупки\",\n\t\t\"entry\": \"Выберите количество и тип билета\",\n\t\t\"pushkin_form\": \"Введите данные держателя карты\"\n\t},\n\t\"appSideBarNextStep\": {\n\t\t\"accessory\": \"$t(AdditionalProducts)\",\n\t\t\"bar\": \"$t(OnlineBar)\",\n\t\t\"bar_sale\": \"Бар\",\n\t\t\"basket\": \"Подтверждение\",\n\t\t\"contacts\": \"Введите данные для билетов\",\n\t\t\"delivery\": \"Доставка\",\n\t\t\"payment\": \"Оплата\",\n\t\t\"pushkin_form\": \"$t(appSideBarNextStep.payment)\"\n\t},\n\t\"atAddress\": \"по адресу: $t(cityAbbreviation)\",\n\t\"atLeast\": \"минимум\",\n\t\"auth\": {\n\t\t\"AccountRegistered\": \"Аккаунт зарегистрирован\",\n\t\t\"AreYouSureYouWantDeleteProfile\": \"Уверены что хотите удалить профиль?\",\n\t\t\"AreYouSureYouWantExit\": \"Уверены, что хотите выйти?\",\n\t\t\"Complete\": \"Завершить\",\n\t\t\"CreatePassword\": \"Придумайте пароль\",\n\t\t\"EmailChanged\": \"Адрес электронной почты изменён\",\n\t\t\"Enter\": \"Войти\",\n\t\t\"EnterInProfileToContinuePlacingOrder\": \"Войдите в профиль, чтобы продолжить оформление заказа\",\n\t\t\"EnterOrInputEmail\": \"Войдите в профиль или введите адрес электронной почты, на который отправим билеты.\",\n\t\t\"EnterOrSignUp\": \"Войти или зарегистрироваться\",\n\t\t\"EnterYourEmail\": \"Пожалуйста, укажите электронную почту на которую был зарегистрирован аккаунт\",\n\t\t\"ExitProfile\": \"Выйти из профиля\",\n\t\t\"errors\": {\n\t\t\t\"AccessDenied\": \"Отсутствует доступ к заданному действию\",\n\t\t\t\"ActiveCardExist\": \"У вас уже есть активная карта. Обратитесь в службу поддержки. Код ошибки: 372\",\n\t\t\t\"BonusCardDeleted\": \"Бонус