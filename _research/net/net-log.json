т все, чтобы фильм его\\r\\nмечты был снят так, как ему нужно и только с ним в главной роли.<o:p></o:p></span></p>\",\"year\":2026,\"poster\":\"https://s1ru1.kinoplan24.ru/891/0406060507c4f4fd9f7947e9/24563.jpg?mode=fit&width=999&height=999\",\"animated_poster\":null,\"thumbnail\":\"https://s1ru1.kinoplan24.ru/891/0406060507c4f4fd9f7947e9/24563.jpg?mode=fit&width=256&height=256\",\"screenshots\":[\"https://s1ru1.kinoplan24.ru/187/0406060507b2c31d51a3139d/129623.jpg?mode=fit&width=512&height=512\",\"https://s1ru1.kinoplan24.ru/205/0406060507b2c31ec1640e56/129624.jpg?mode=fit&width=512&height=512\",\"https://s2ru1.kinoplan24.ru/468/0406060507b2c31fd87ad39f/129625.jpg?mode=fit&width=512&height=512\",\"https://s1ru1.kinoplan24.ru/214/0406060507b2c3210e16a27e/129626.jpg?mode=fit&width=512&height=512\",\"https://s2ru1.kinoplan24.ru/772/0406060507b2c32295409fb5/129627.jpg?mode=fit&width=512&height=512\",\"https://s2ru1.kinoplan24.ru/652/0406060507b2c323e93a3222/129628.jpg?mode=fit&width=512&height=512\"],\"duration\":127,\"rating\":{},\"qualifiers\":[\"premiere\"],\"all_qualifiers\":[\"premiere\"],\"russia_start_date\":\"2026-11-19\",\"cinema_start_date\":\"2026-11-19\",\"is_movie\":false,\"seance_dates\":[{\"date\":\"2026-11-19\",\"seance_ids\":[\"6afac5d23c0000bf00638151\",\"6afac61c3c0000850063818c\",\"6afac5cc3f0000a800d4df6f\",\"6afac6153c0000b600638180\",\"6af1e1643c0000460028e7fc\",\"6afac6103f00004d00d4dfaa\",\"6afaddc63f00004b00a242c4\",\"6afadcf53f00005000a2408e\"]},{\"date\":\"2026-11-23\",\"seance_ids\":[\"6b0021f4400000a900b14830\",\"6b0021f4400000a900b147f9\",\"6b0021f4400000a900b147e8\",\"6b0021f4400000a900b147fa\",\"6b0021f4400000a900b147e9\",\"6b0021f4400000a900b147fb\",\"6b0021f4400000a900b147ea\",\"6b0021f4400000a900b147fc\",\"6b0021f4400000a900b147eb\",\"6b0021f4400000a900b14802\"]},{\"date\":\"2026-11-26\",\"seance_ids\":[\"6b0412fb400000bb002f0983\",\"6b0408b23d00004200a76e47\",\"6b04136f3e0000b600104592\",\"6b0408af40000087002ee7df\",\"6b04086a3d0000